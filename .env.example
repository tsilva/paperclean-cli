# Non-secret configuration for a local gateway without application authentication.
# Authenticated agent use requires a separately reviewed sandboxed broker route;
# this repository configures neither that route nor its credential placeholder.
PAPERCLEAN_BACKEND=openrouter
AGENTBRIDGE_BASE_URL=http://127.0.0.1:8082/api/v1
# PAPERCLEAN_AGENTBRIDGE_TIMEOUT=660
PAPERCLEAN_IMAGE_MODEL=openai/gpt-image-2
PAPERCLEAN_REVIEW_MODEL=openai/gpt-5.6-sol
PAPERCLEAN_MAX_ATTEMPTS=3
PAPERCLEAN_JOBS=1
# PAPERCLEAN_MAX_COST_USD=1.00
PAPERCLEAN_ZDR=false
